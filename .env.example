# Copy to .env.local for development, and set these in Vercel/Netlify for production.

# Canonical site URL — used for canonical tags, sitemap, robots and OG images.
# No trailing slash. Must be the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://reputera.com

# ---------------------------------------------------------------------------
# Lead delivery — set AT LEAST ONE of the options below, or form submissions
# are validated and logged but never delivered anywhere.
# ---------------------------------------------------------------------------

# Option A: POST each submission as JSON to a webhook (Zapier, Make, n8n,
# Slack incoming webhook, or your own CRM endpoint).
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/abcdef

# Option B: email each submission via Resend (https://resend.com).
# All three are required together.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# LEAD_EMAIL_TO=hello@reputera.com
# LEAD_EMAIL_FROM=website@reputera.com
